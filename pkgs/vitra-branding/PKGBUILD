package() {
    install -Dm644 vitra-logo.svg      "$pkgdir/usr/share/icons/hicolor/scalable/apps/vitra-logo.svg"
    install -Dm644 vitra-logo-tile.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vitra.svg"
    install -Dm644 vitra-logo.svg      "$pkgdir/usr/share/pixmaps/vitra-logo.svg"
    install -Dm644 vitra-logo-tile.svg "$pkgdir/usr/share/pixmaps/vitra-logo-tile.svg"
    install -Dm644 vitra-logo-512.png  "$pkgdir/usr/share/pixmaps/vitra-logo.png"
    for s in 16 32 48 64 128 256 512; do
        install -Dm644 "vitra-logo-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/vitra-logo.png"
    done
    install -Dm644 fastfetch-vitra.txt       "$pkgdir/usr/share/fastfetch/logos/vitra.txt"
    install -Dm644 fastfetch-vitra_small.txt "$pkgdir/usr/share/fastfetch/logos/vitra_small.txt"
    install -Dm644 fastfetch-config.jsonc    "$pkgdir/etc/xdg/fastfetch/config.jsonc"
    install -Dm755 vitra-branding            "$pkgdir/usr/bin/vitra-branding"
    install -Dm644 vitra-branding.hook       "$pkgdir/usr/share/libalpm/hooks/vitra-branding.hook"
}
