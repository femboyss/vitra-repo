// Vitra default fastfetch config - (c) 2026 34 & Claude
// Your own ~/.config/fastfetch/config.jsonc wins over this file.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/fastfetch/logos/vitra.txt",
    "color": { "1": "38;2;236;236;244", "2": "38;2;142;142;156" }
  },
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "wm", "theme", "icons", "font", "cursor", "terminal", "terminalfont",
    "cpu", "gpu", "memory", "swap", "disk", "localip", "battery", "poweradapter",
    "locale", "break", "colors"
  ]
}
