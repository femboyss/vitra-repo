pkgname=vitra-branding
pkgver=1.0.0
pkgrel=1
pkgdesc="Vitra logo, icons, fastfetch logo and os-release branding"
arch=('any')
url="https://github.com/femboyss/vitra-repo"
license=('GPL-3.0-or-later')
depends=('bash' 'filesystem')
optdepends=('fastfetch: shows the Vitra logo')
install=vitra-branding.install
source=(vitra-logo.svg vitra-logo-tile.svg
        vitra-logo-16.png vitra-logo-32.png vitra-logo-48.png vitra-logo-64.png
        vitra-logo-128.png vitra-logo-256.png vitra-logo-512.png
        fastfetch-vitra.txt fastfetch-vitra_small.txt fastfetch-config.jsonc
        vitra-branding vitra-branding.hook)
